              "raw": "{\"ventaId\": 5, \"motivo\": \"ARREPENTIMIENTO\", \"comentario\": \"Coleccion Postman del CI\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201 (o 201 repetido si la coleccion ya corrio)\", () => pm.response.to.have.status(201));",
                  "const d = pm.response.json();",
                  "pm.test(\"Devuelve la devolucion con su ETag y Location\", () => {",
                  "  pm.expect(d.ventaId).to.eql(5);",
                  "  pm.expect(pm.response.headers.get(\"ETag\")).to.match(/^\".+\"$/);",
                  "  pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/devoluciones/\" + d.id);",
                  "});",
                  "pm.collectionVariables.set(\"devolucionId\", d.id);"
                ]
              }
            }
          ]
