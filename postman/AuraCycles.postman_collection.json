        {
          "name": "Aprobar con el ETag vigente",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenModerador}}"
              },
              {
                "key": "If-Match",
                "value": "{{etag}}"
              }
            ],
            "url": {
              "raw": "{{base}}/devoluciones/{{devolucionId}}",
              "host": [
                "{{base}}"
              ],
              "path": [
                "devoluciones",
                "{{devolucionId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"estado\": \"APROBADA\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// La primera corrida la aprueba (200). Si la coleccion se vuelve a correr sobre la misma base,",
                  "// la devolucion ya no esta PENDIENTE y el State tiene que responder 409",
                  "if (pm.collectionVariables.get(\"estadoAntes\") === \"PENDIENTE\") {",
                  "  pm.test(\"Responde 200 y queda APROBADA\", () => { pm.response.to.have.status(200); pm.expect(pm.response.json().estado).to.eql(\"APROBADA\"); });",
                  "} else {",
                  "  pm.test(\"Ya resuelta: 409 del State\", () => pm.response.to.have.status(409));",
                  "}",
                  "pm.collectionVariables.set(\"etag\", pm.response.headers.get(\"ETag\") || pm.collectionVariables.get(\"etag\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ver de nuevo cuando terminan los consumidores",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenModerador}}"
              }
            ],
            "url": {
              "raw": "{{base}}/devoluciones/{{devolucionId}}",
              "host": [
                "{{base}}"
              ],
              "path": [
                "devoluciones",
                "{{devolucionId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Al aprobar, stock, reembolso y aviso cambian la devolucion por el topico y con eso cambia el ETag.",
                  "// Se espera a que terminen para tomar el ETag final",
                  "setTimeout(() => {}, 4000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"etag\", pm.response.headers.get(\"ETag\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Rechazar una ya aprobada: 409 del State",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenModerador}}"
              },
              {
                "key": "If-Match",
                "value": "{{etag}}"
              }
            ],
            "url": {
              "raw": "{{base}}/devoluciones/{{devolucionId}}",
              "host": [
                "{{base}}"
              ],
              "path": [
                "devoluciones",
                "{{devolucionId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"estado\": \"RECHAZADA\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"Problem Details (RFC 9457)\", () => {",
                  "  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
                  "  const p = pm.response.json();",
                  "  pm.expect(p).to.have.all.keys(\"type\", \"title\", \"status\", \"detail\", \"instance\");",
                  "  pm.expect(p.status).to.eql(pm.response.code);",
                  "});",
                  "pm.test(\"Tipo transicion-invalida\", () => pm.expect(pm.response.json().type).to.eql(\"urn:auracycles:problema:transicion-invalida\"));"
                ]
              }
            }
          ]
        }
      ]
