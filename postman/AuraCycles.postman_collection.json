        {
          "name": "Login cliente (Lucia)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/auth/login",
              "host": [
                "{{base}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"lucia@mail.com\", \"password\": \"{{clave}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"Devuelve un JWT Bearer de 15 minutos\", () => { pm.expect(r.tipo).to.eql(\"Bearer\"); pm.expect(r.expiraEn).to.eql(900); pm.expect(r.rol).to.eql(\"CLIENTE\"); });",
                  "pm.collectionVariables.set(\"tokenCliente\", r.token);"
                ]
              }
            }
          ]
        },
