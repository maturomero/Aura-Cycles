# Formato del codigo, lo leen Eclipse, IntelliJ y VS Code. Checkstyle (checkstyle.xml) lo exige en el build
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = space
indent_size = 4
max_line_length = 160

[*.{xml,yml,yaml,xhtml}]
indent_style = space
indent_size = 2
