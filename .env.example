# Copiar a ".env" (no se sube al repo) y completar solo lo que se quiera cambiar.
# Sin .env todo anda igual, contra los simuladores.

# ---------- Mercado Pago real, con las credenciales de prueba ----------
# Las tres lineas van juntas.
# El token es el Access Token de "Credenciales de prueba" de la aplicacion (empieza con APP_USR-).
# AURA_URL es por donde se entra a la tienda: Mercado Pago no acepta localhost para la vuelta, va la IP de la maquina.
#MP_ACCESS_TOKEN=APP_USR-...
#MP_BASE_URL=https://api.mercadopago.com
#AURA_URL=https://192.168.0.15:8443/repuestos

# ---------- IA real en vez del modelo simulado ----------
#IA_URL=https://api.anthropic.com
#IA_API_KEY=...

# ---------- Clave de firma de los JWT de la API (32 caracteres o mas) ----------
# Vacia: la app genera una al arrancar y los tokens dejan de valer al reiniciar.
#JWT_SECRET=
